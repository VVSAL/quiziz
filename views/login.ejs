<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <title>Login Ujian TIK</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
        * {
            box-sizing: border-box;
            font-family: "Segoe UI", Tahoma, Arial, sans-serif;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background: linear-gradient(135deg, #e3f2fd, #bbdefb);
            display: flex;
            justify-content: center;
            align-items: center;
            color: #0d47a1;
        }

        .login-card {
            background: #ffffff;
            width: 100%;
            max-width: 380px;
            padding: 32px 28px;
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
            animation: fadeIn 0.5s ease;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .login-card h2 {
            text-align: center;
            margin-top: 0;
            margin-bottom: 8px;
            color: #1565c0;
        }

        .subtitle {
            text-align: center;
            font-size: 13px;
            color: #546e7a;
            margin-bottom: 22px;
        }

        .login-card input {
            width: 100%;
            padding: 12px 14px;
            margin-bottom: 14px;
            border-radius: 8px;
            border: 1px solid #bbdefb;
            font-size: 14px;
        }

        .login-card input:focus {
            outline: none;
            border-color: #64b5f6;
            box-shadow: 0 0 0 2px rgba(100, 181, 246, 0.25);
        }

        .login-card button {
            width: 100%;
            padding: 12px;
            border: none;
            border-radius: 25px;
            background: #1e88e5;
            color: #ffffff;
            font-size: 15px;
            font-weight: bold;
            cursor: pointer;
            transition: 0.2s;
            box-shadow: 0 6px 14px rgba(0, 0, 0, 0.2);
        }

        .login-card button:hover {
            background: #1565c0;
        }

        .note {
            margin-top: 18px;
            font-size: 13px;
            text-align: center;
            color: #455a64;
        }

        @media (max-width: 480px) {
            .login-card {
                margin: 0 14px;
                padding: 26px 22px;
            }
        }
    </style>
</head>

<body>

    <div class="login-card">
        <h2>Login quiziz Minguan</h2>
        <div class="subtitle">
            Silakan isi data untuk memulai ujian
        </div>

        <form method="POST" action="/login">
            <input type="text" name="nama" placeholder="Nama Lengkap" required>
            <input type="text" name="kelas" placeholder="Kelas" required>
            <button type="submit">Mulai Ujian</button>
        </form>

        <div class="note">
            💡 Coba sampai tiga kali agar mendapatkan nilai bagus
        </div>
    </div>

</body>

</html>