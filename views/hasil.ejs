<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <title>Hasil Ujian</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <style>
        * {
            box-sizing: border-box;
            font-family: "Segoe UI", Tahoma, Arial, sans-serif;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background: linear-gradient(135deg, #e3f2fd, #bbdefb);
            display: flex;
            justify-content: center;
            align-items: center;
            color: #0d47a1;
        }

        .wrapper {
            text-align: center;
        }

        .result-card {
            background: #ffffff;
            width: 100%;
            max-width: 420px;
            padding: 30px 28px;
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
            text-align: center;
            animation: fadeIn 0.5s ease;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .result-card h2 {
            margin-top: 0;
            margin-bottom: 20px;
            color: #1565c0;
        }

        .info {
            text-align: left;
            margin: 18px 0;
            font-size: 15px;
        }

        .info p {
            margin: 10px 0;
        }

        .score-box {
            margin: 25px 0;
            padding: 18px;
            border-radius: 12px;
            background: #e3f2fd;
            border: 1px solid #bbdefb;
        }

        .score-label {
            font-size: 14px;
            color: #1565c0;
            margin-bottom: 6px;
        }

        .score-value {
            font-size: 36px;
            font-weight: bold;
            color: #0d47a1;
        }

        .footer-text {
            margin-top: 20px;
            font-size: 13px;
            color: #546e7a;
        }

        .back-link {
            display: inline-block;
            margin-top: 18px;
            font-size: 14px;
            color: #1565c0;
            text-decoration: none;
            transition: 0.2s;
        }

        .back-link:hover {
            text-decoration: underline;
            color: #0d47a1;
        }

        @media (max-width: 480px) {
            .result-card {
                margin: 0 14px;
                padding: 24px 20px;
            }

            .score-value {
                font-size: 32px;
            }
        }
    </style>
</head>

<body>

    <div class="wrapper">
        <div class="result-card">
            <h2>Hasil Ujian</h2>

            <div class="info">
                <p><b>Nama</b> : <%= nama %>
                </p>
                <p><b>Kelas</b> : <%= kelas %>
                </p>
            </div>

            <div class="score-box">
                <div class="score-label">Nilai Akhir</div>
                <div class="score-value">
                    <%= nilai %>
                </div>
            </div>

            <div class="footer-text">
                Terima kasih telah mengerjakan ujian.<br>
                Silakan lapor ke guru pengawas.
            </div>
        </div>

        <!-- LINK KEMBALI -->
        <a href="/" class="back-link">← Kembali ke Login</a>
    </div>

</body>

</html>